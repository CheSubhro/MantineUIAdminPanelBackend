meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: inherit
}

body:json {
  {
      "name": "John Doe",
      "username": "johndoe",
      "email": "john@example.com",
      "password": "{{password}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
